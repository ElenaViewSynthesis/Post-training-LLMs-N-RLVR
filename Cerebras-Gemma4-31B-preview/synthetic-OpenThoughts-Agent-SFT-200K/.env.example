CEREBRAS_API_KEY=your_cerebras_api_key_here
HF_TOKEN=your_huggingface_read_write_token_here
HF_HUB_ENABLE_HF_TRANSFER=1
CEREBRAS_MODEL_ID=cerebras/Gemma4-31B-preview
HF_DATASET_REPO_ID=borntobeignored/OpenThoughts-Agents-SFT-250k

# Together.ai backend (~$15-20 for 150K samples — recommended over SageMaker for cost)
# Get key at: api.together.ai
TOGETHER_API_KEY=
TOGETHER_MODEL_ID=meta-llama/Llama-3.3-70B-Instruct-Turbo

# SageMaker backend (set these after running deploy_sagemaker.py)
# When SAGEMAKER_ENDPOINT_NAME is set, SageMaker takes priority over Together.ai
SAGEMAKER_ENDPOINT_NAME=
AWS_REGION=us-east-1
