# Generation providers (set only the keys you use)
CEREBRAS_API_KEY=
CEREBRAS_MODEL_ID=gemma-4-31b
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_THINKING_LEVEL=medium

# Local pipeline state (override this under WSL when /mnt/c is authoritative)
PIPELINE_DATA_DIR=~/pipeline/data

# Conservative streaming-refinement defaults; raise only after a successful pilot
GEMINI_CONCURRENCY=4
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=180
REFINEMENT_TARGET_ROWS=150000
REFINEMENT_REQUEST_BATCH_SIZE=32
REFINEMENT_MAX_ATTEMPTS_PER_RUN=3
REFINEMENT_SYNC_EVERY_SHARDS=10

# Optional Hugging Face refinement-state and publication syncing
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1
HF_REFINEMENT_BUCKET=hf://buckets/borntobeignored/OpenThoughts-Agents-SFT-250k/refined
HF_PUBLICATION_BUCKET=hf://buckets/borntobeignored/OpenThoughts-Agents-SFT-250k
