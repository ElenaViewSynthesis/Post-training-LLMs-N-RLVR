# Generation providers (set only the keys you use)
CEREBRAS_API_KEY=
CEREBRAS_MODEL_ID=gemma-4-31b
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Conservative Gemini worker defaults; raise only after a successful pilot
GEMINI_CONCURRENCY=4
GEMINI_BATCH_SIZE=60
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=180

# Optional Hugging Face result syncing
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1
