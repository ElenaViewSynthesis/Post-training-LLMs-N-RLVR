# Copy this file to .env and fill in your values.
#   cp .env.sample .env

# ── Lambda Cloud ──────────────────────────────────────────────────────────────
LAMBDA_API_KEY=
LAMBDA_SSH_KEY_NAME=

# ── GPU / CUDA ────────────────────────────────────────────────────────────────
# Leave blank to use all visible GPUs ("auto" device_map)
GPU_ID=

# ── Model ─────────────────────────────────────────────────────────────────────
HF_TOKEN=
MODEL_ID=google/gemma-4-12B-it

# ── W&B (optional, for training runs) ────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=gemma-4-12b-instruction
