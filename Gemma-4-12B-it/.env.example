# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Lambda Cloud (provisioning) ───────────────────────────────────────────────
# Controls which VM to spin up via the Lambda API (lambda_gpu.py).
LAMBDA_API_KEY=
LAMBDA_SSH_KEY_NAME=
LAMBDA_SSH_KEY_PATH=~/.ssh/id_rsa
# Which Lambda instance type to launch — sets the hardware before any code runs.
# See available types: uv run lambda_gpu.py list-types
LAMBDA_INSTANCE_TYPE=gpu_1x_a100_sxm4

# ── GPU / CUDA (runtime) ──────────────────────────────────────────────────────
# CUDA device index *within* a running instance used by inference scripts.
# Different from LAMBDA_INSTANCE_TYPE: that picks the VM, this picks the GPU
# inside the VM. Leave blank to let device_map="auto" use all visible GPUs.
GPU_ID=

# ── Model ─────────────────────────────────────────────────────────────────────
HF_TOKEN=
MODEL_ID=google/gemma-4-12B-it

# ── W&B (optional, for training runs) ────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=elenamylocuda-gemma/gemma-4-12b-it
